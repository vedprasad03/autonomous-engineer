# --- Project-specific (autonomous-engineer) ---
# Local database (SQLite default; see PRD §18)
*.sqlite3
*.sqlite3-journal
*.db

# Per-run event logs, patches and other run artifacts (PRD §18, §19).
# NOTE: no global *.patch rule — reference-fix patches used to validate
# benchmark tasks (PRD §13) and stored patches re-verified for the ≥99%
# target (PRD §24) are tracked inputs. Run output belongs under runs/.
runs/

# Sandbox build context / per-task repository checkouts (PRD §11)
sandbox/
.sandbox/

# Benchmark task data pulled from external sources, e.g. SWE-bench (PRD §13).
# Mini-benchmark task specs are a tracked core asset — they live in
# benchmarks/tasks/, NOT here.
benchmarks/data/

# Locally downloaded model weights, if not managed by Ollama/LM Studio (PRD §18)
models/
*.gguf

# Personal engineering log and context snapshot (local-only, not part of the repo)
ENGINEERING_LOG.md
CONTEXT.md

